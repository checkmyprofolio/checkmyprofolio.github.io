# Optional small-model inference (server only; never use NEXT_PUBLIC_).
# Ollama's OpenAI-compatible endpoint. Run: ollama pull qwen2.5:3b
PORTFOLIO_MODEL_BASE_URL=http://127.0.0.1:11434/v1
PORTFOLIO_MODEL=qwen2.5:3b
# Set for a hosted OpenAI-compatible inference service requiring authentication.
PORTFOLIO_MODEL_API_KEY=
# Optional token to raise public GitHub API limits. No visitor login required.
PORTFOLIO_GITHUB_TOKEN=

# Existing Formspree contact form ID (public, not a secret).
NEXT_PUBLIC_CONTACT_FORM_ID=mgvnadyy
