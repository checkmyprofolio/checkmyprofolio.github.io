{
  "name": "meeraai-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Premium desktop frontend for MeeraAI",
  "author": "Vidit Shah",
  "main": "dist-electron/main.js",
  "scripts": {
    "predev": "node scripts/sync-logo.js && python scripts/prepare-nsis-theme.py",
    "prebuild": "node scripts/sync-logo.js && python scripts/prepare-nsis-theme.py",
    "dev": "concurrently \"vite\" \"wait-on http-get://localhost:5173 && tsc -p electron/tsconfig.json && electron .\"",
    "build": "vite build && tsc -p electron/tsconfig.json",
    "package": "npm run build && node scripts/run-electron-builder.js --win --x64",
    "dist": "npm run build && node scripts/run-electron-builder.js",
    "backend": "python ../Meera.py --api --port 8000",
    "preview": "vite preview"
  },
  "build": {
    "appId": "com.meera.desktop",
    "productName": "MeeraAI",
    "copyright": "Copyright © Vidit Shah",
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "logo.ico",
      "executableName": "MeeraAI"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "extraFiles": [
      {
        "from": "../Meera.py",
        "to": "Meera.py"
      }
    ],
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": false,
      "perMachine": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "installerIcon": "logo.ico",
      "uninstallerIcon": "logo.ico",
      "installerHeaderIcon": "logo.ico",
      "installerHeader": "installer-header.bmp",
      "installerSidebar": "installer-welcome.bmp",
      "uninstallerSidebar": "installer-welcome.bmp"
    }
  },
  "dependencies": {
    "@react-three/drei": "^9.121.5",
    "@react-three/fiber": "^8.18.0",
    "firebase": "^10.12.2",
    "framer-motion": "^11.11.17",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-icons": "^5.6.0",
    "react-markdown": "^9.0.1",
    "react-syntax-highlighter": "^15.5.0",
    "remark-gfm": "^4.0.1",
    "three": "^0.183.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "wait-on": "^8.0.1"
  }
}
